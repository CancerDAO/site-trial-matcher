SITE_TRIAL_HOST=127.0.0.1
SITE_TRIAL_PORT=8080
SITE_TRIAL_PROJECT_ROOT=.
SITE_TRIAL_DATA_ROOT=./var
SITE_TRIAL_MODEL_ENABLED=0
SITE_TRIAL_MODEL_WORKERS=4
SITE_TRIAL_RETENTION_HOURS=24

# Optional when the platform calls this service server-to-server.
# SITE_TRIAL_API_TOKEN=replace-with-a-long-random-secret

# Required only when SITE_TRIAL_MODEL_ENABLED=1.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.7
