SITE_TRIAL_HOST=127.0.0.1
SITE_TRIAL_PORT=8080
SITE_TRIAL_PROJECT_ROOT=.
SITE_TRIAL_DATA_ROOT=./var
SITE_TRIAL_ONTOLOGY=./data/disease_ontology.json
SITE_TRIAL_MODEL_ENABLED=1
SITE_TRIAL_MODEL_WORKERS=4
SITE_TRIAL_RETENTION_HOURS=24

# Optional when the platform calls this service server-to-server.
# SITE_TRIAL_API_TOKEN=replace-with-a-long-random-secret

# Required when SITE_TRIAL_MODEL_ENABLED=1. OpenAI-compatible endpoint.
# Kimi Coding example (K3 requires temperature=1):
# SITE_TRIAL_MODEL_API_KEY=
# SITE_TRIAL_MODEL_BASE_URL=https://api.kimi.com/coding/v1
# SITE_TRIAL_MODEL_NAME=k3
# SITE_TRIAL_MODEL_TEMPERATURE=1
# SITE_TRIAL_MODEL_TOKEN_PARAMETER=max_tokens
# Legacy MINIMAX_API_KEY/MINIMAX_BASE_URL/MINIMAX_MODEL remain supported.
